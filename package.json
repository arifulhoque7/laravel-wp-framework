{
  "name": "laravel-wp-framework",
  "version": "1.0.0",
  "description": "Laravel-inspired WordPress plugin architecture with separated admin and frontend React applications",
  "private": true,
  "scripts": {
    "build": "npm run build:admin && npm run build:frontend",
    "build:admin": "wp-scripts build resources/admin/js/index.js --output-path=build/admin",
    "build:frontend": "wp-scripts build resources/frontend/js/index.js --output-path=build/frontend",
    "start": "npm run start:admin",
    "start:admin": "wp-scripts start resources/admin/js/index.js --output-path=build/admin",
    "start:frontend": "wp-scripts start resources/frontend/js/index.js --output-path=build/frontend",
    "dev": "concurrently \"npm run start:admin\" \"npm run start:frontend\"",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:pkg-json": "wp-scripts lint-pkg-json"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "laravel",
    "react",
    "framework",
    "mvc"
  ],
  "author": "Your Name",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@wordpress/scripts": "^28.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/element": "^6.0.0",
    "lucide-react": "^0.552.0"
  }
}
